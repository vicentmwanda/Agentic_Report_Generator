# Gemini LLM API Key (From Google AI Studio or Google Cloud Console)
GOOGLE_API_KEY=your_gemini_api_key_here

# Google Custom Search API Key (GCP API Key starting with AIzaSy...).
# Optional: If left blank, it defaults to using GOOGLE_API_KEY above.
GOOGLE_SEARCH_API_KEY=your_gcp_custom_search_api_key_here

# Google Custom Search Engine (CSE) ID (From https://programmablesearchengine.google.com/)
GOOGLE_CSE_ID=your_google_cse_id_here
